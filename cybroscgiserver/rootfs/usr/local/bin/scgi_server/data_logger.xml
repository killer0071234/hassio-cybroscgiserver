<!-- data logger configuration -->

<configuration>

  <!-- list organizes a number of variables into a named group -->

  <list>
    <group>
      <name>cybro</name>
      <item>c20000</item>
      <item>c20001</item>
      <item>c20002</item>
    </group>
    <group>
      <name>measurements</name>
      <item>cybro_iw12</item>
      <item>cybro_iw13</item>
      <item>cybro_iw14</item>
      <item>cybro_iw15</item>
    </group>
  </list>

  <!-- variables that are stored periodically -->

  <sample>
    <task>
      <period>5s</period>
      <enabled>true</enabled>
      <variable>{cybro}.cybro_ix00</variable>
      <variable>{cybro}.cybro_ix01</variable>
    </task>
    <task>
      <period>10s</period>
      <enabled>true</enabled>
      <variable>{cybro}.{measurements}</variable> <!-- 12 variables -->
    </task>
  </sample>

  <!-- variables that are checked periodically and stored on 0-to-1 transition -->

  <event>
    <task>
      <period>5s</period>
      <enabled>true</enabled>
      <variable>{cybro}.cybro_qx00</variable>
      <class>iomonitor</class>
      <priority>low</priority>
      <message>Controller output is activated</message>
    </task>
  </event>

  <!-- variables that are checked periodically and stored on 0-to-1 or out-of-range transition -->

  <alarm>
    <task>
      <period>5s</period>
      <enabled>true</enabled>
      <variable>{cybro}.scan_overrun</variable>
      <variable>{cybro}.scan_time_max</variable>
      <class>system</class>
      <priority>high</priority>
      <message>Scan time exceeded limit</message>
    </task>
    <task>
      <period>5s</period>
      <enabled>true</enabled>
      <variable>{cybro}.cybro_power_supply</variable>
      <lolimit>200</lolimit>
      <hilimit>260</hilimit>
      <hysteresis>10</hysteresis>
      <class>system</class>
      <priority>medium</priority>
      <message>Power supply out of range</message>
    </task>
  </alarm>

</configuration>